# ── Database (Supabase) ── run supabase/schema.sql first
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin ──
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ── Public URL (used for payment return/webhook URLs) ──
SITE_URL=https://your-domain.co.il

# ── Payments ──
# mock = test page, no charge (allowed only outside production unless ALLOW_MOCK_PAYMENTS=true)
# provider = the real Israeli provider adapter (src/lib/payments/israeli-provider.template.ts)
PAYMENT_PROVIDER=mock
# ALLOW_MOCK_PAYMENTS=true

# ── WhatsApp / SMS confirmation (optional) ──
# webhook = POST { to, text, orderNumber } to your gateway / Make / n8n
MESSAGING_PROVIDER=
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_SECRET=
